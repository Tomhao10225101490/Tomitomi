{
  "name": "tomtube",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:setup": "node --import tsx prisma/migrate.ts && node --import tsx prisma/seed.ts",
    "worker": "node --import tsx lib/worker.ts",
    "test:e2e": "playwright test",
    "db:generate": "PRISMA_SCHEMA_ENGINE_BINARY=/bin/true PRISMA_QUERY_ENGINE_LIBRARY=/bin/true prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^6.19.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "better-sqlite3": "^11.10.0",
    "lucide-react": "0.468.0",
    "next": "15.5.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.34.5",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "9.25.1",
    "eslint-config-next": "15.5.12",
    "prisma": "6.19.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.1.2"
  }
}
